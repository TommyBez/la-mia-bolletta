# Pull development values securely with `vercel env pull .env.local`.
# Neon and Blob are connected to the project's Development and Preview environments.
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=
# OIDC is injected automatically on Vercel; refresh locally with `vercel env pull`.
VERCEL_OIDC_TOKEN=
# Internal catalog refresh authentication; never expose to the browser.
CRON_SECRET=
# Read-only MCP access, separate from the import credential.
MCP_ACCESS_TOKEN=
# Tests use a separate, disposable PostgreSQL database.
TEST_DATABASE_URL=postgresql://postgres:lmb_local_test_only@127.0.0.1:55432/lmb_test
